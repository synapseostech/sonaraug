{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm exec next build"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "buildCommand": "pnpm exec next build"
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "buildCommand": "pnpm exec next build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
