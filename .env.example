# ---------------------------------------------------------------------------
# SONARA media platform (codename kito) — environment template
# Copy to .env.local (never commit real values). All variables are validated
# at boot by packages/config/src/env.ts; the app refuses to start if a
# required value is missing or malformed.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Brand (all optional — defaults come from packages/config/src/brand.ts)
NEXT_PUBLIC_BRAND_NAME=Sonara
NEXT_PUBLIC_BRAND_TAGLINE=Radio, podcasts, Medical Chronicles and video for Uganda
NEXT_PUBLIC_BRAND_ACCENT=#F5A524
NEXT_PUBLIC_MARKETING_SITE=https://example.invalid
BRAND_DEFAULT_LOCALE=en-UG
BRAND_SUPPORT_EMAIL=support@example.invalid
BRAND_LEGAL_ENTITY=

# ---------------------------------------------------------------------------
# Backend selection (see docs/SONARA_BACKEND_MIGRATION.md)
# ---------------------------------------------------------------------------
# dev      = local JSON store + development auth. Allowed outside production only.
# supabase = Supabase Auth + Supabase Postgres with RLS.
# unset    = dev in development, supabase in production (and therefore an error
#            if Supabase is not configured — it never falls back silently).
SONARA_BACKEND=
# Smoke-test escape hatch ONLY, for a production build served on localhost.
# NEVER set this on a real deployment; docs/SONARA_SECURITY_STATUS.md N-1/N-2.
SONARA_ALLOW_DEV_BACKEND=
SONARA_TRUST_PROXY=1
SONARA_DB_POOL_MAX=10

# Supabase — dedicated SONARA project only. Never the healthcare project.
# NEXT_PUBLIC_* values reach the browser; the rest are server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Server-only: hosted Postgres connection string (use the transaction pooler on Vercel).
SUPABASE_DB_URL=
# Optional server-only PEM CA certificate from Supabase Database Settings → SSL Configuration.
# Required when the runtime does not trust the CA presented by the project's database endpoint.
SUPABASE_DB_CA_CERT=
# CLI/deploy token (not used by the app at runtime).
SUPABASE_ACCESS_TOKEN=
# Legacy Supabase names, kept for the other apps in the workspace:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_MEDIA=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
STREAM_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags (defaults are safe = off)
FF_ENABLE_DOWNLOADS=false
FF_ENABLE_COMMENTS=true
FF_ENABLE_ADVERTISING=false
DATA_SAVER_DEFAULT=true

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL used in emails and payment redirects (no trailing slash).
SONARA_APP_URL=http://127.0.0.1:3100

# Local development store (JSON on the server's disk). Never used in production
# unless SONARA_ALLOW_DEV_BACKEND=1 is set for a local production-build smoke test.
SONARA_DATA_DIR=
SONARA_ALLOW_DEV_BACKEND=
SONARA_MAX_AUDIO_MB=300

# Email. Dev backend: "dev_outbox" writes to the on-server outbox at /dev/outbox.
# Supabase backend (SONARA_EMAIL_PROVIDER): smtp | log | none. See
# docs/SONARA_EMAIL_CONFIGURATION.md. SMTP_PASS is server-only.
SONARA_EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sonara <no-reply@example.invalid>

# ---------------------------------------------------------------------------
# Payments — Flutterwave (SERVER ONLY. Never prefix these with NEXT_PUBLIC_.)
# ---------------------------------------------------------------------------
# simulator   = local Flutterwave stand-in (development only, no money moves)
# flutterwave = real Flutterwave API using the keys below
SONARA_PAYMENTS_MODE=simulator
# test | live. Live also needs FLW_LIVE_APPROVED=yes AND the admin setting
# "Allow live Flutterwave payments". Do not enable before owner approval and KYC.
FLW_ENVIRONMENT=test
FLW_LIVE_APPROVED=
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# The "secret hash" set in the Flutterwave dashboard (Settings > Webhooks).
# Sent back in the verif-hash header of every webhook. At least 16 characters.
FLW_WEBHOOK_SECRET_HASH=
# Optional override of the API base URL (default https://api.flutterwave.com).
FLW_API_BASE=
# Supported checkout currencies (UGX first). Informational until multi-currency launches.
SONARA_SUPPORTED_CURRENCIES=UGX
# Register these in the Flutterwave dashboard:
#   Webhook URL:  ${SONARA_APP_URL}/api/payments/flutterwave/webhook
#   Redirect URL: ${SONARA_APP_URL}/api/payments/flutterwave/callback (sent per checkout)

# --- AI tutor (Groq) — Medical Chronicles notes, quizzes and viva. SERVER ONLY. ---
# Subscribers' AI quizzes and the editors' "Draft quiz from notes" button stay off until this is set.
GROQ_API_KEY=
# Optional: a Groq model that supports JSON object mode (default openai/gpt-oss-120b).
GROQ_MODEL=
